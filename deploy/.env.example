# 金田：1851 — 线上环境变量模板
# 复制为 deploy/.env（已被根 .gitignore 的 `.env` 规则忽略，不会入库），填真实值后使用：
#   cp deploy/.env.example deploy/.env
# compose 用 --env-file deploy/.env 读取，同时用于 ${} 替换。

# ===== PostgreSQL（仅容器内网 + 127.0.0.1:5544 回环，不对公网暴露）=====
POSTGRES_USER=jintian
POSTGRES_DB=jintian
# 必须改：线上库不能用默认弱密码。生成：openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ===== LLM（硅基流动）=====
# 与本机 server/.env 的 OPENAI_API_KEY 同源；这里的值经 NUXT_ 前缀覆盖构建期烘进
# .output 的默认值，不改就会用本机开发 key 跑线上，且计费混在一起
NUXT_OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NUXT_OPENAI_BASE_URL=https://api.siliconflow.cn/v1
NUXT_LLM_MODEL=Qwen/Qwen3-8B

# ===== 功能开关 =====
# 局势简报（军师）：true 开启；关掉可省一部分 LLM 调用，见 docs/ai-cost.md
NUXT_ENABLE_BRIEFING=true
