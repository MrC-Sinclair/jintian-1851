# LLM Provider 配置（硅基流动 SiliconFlow）
# 注册获取 API Key: https://cloud.siliconflow.cn
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.siliconflow.cn/v1

# 默认 LLM 模型（Qwen3-8B 支持工具调用 + 可切换思考）
LLM_MODEL=Qwen/Qwen3-8B

# 数据库连接（PostgreSQL 18，端口 5534 避开 my-chat 的 5434）
DATABASE_URL=postgresql://sw_game:YOUR_DB_PASSWORD@localhost:5534/sw_game

# 存档归属鉴权（设备凭据）双轨开关。两个都不需要密钥——凭据由服务端随机生成、
# 库里只存 sha256，所以不存在「轮换签名密钥」这类运维动作。
#
# 开发期保持默认（兼容期）即可：不带 x-device-token 的老客户端仍能凭 deviceId 访问。
# 收紧分两步，顺序不能反：
#   1. 前端已全量升级、服务端 [auth-compat] 日志归零后，才把 ENFORCED 置 true
#   2. 「抢注未绑定 deviceId」的窗口用 REQUIRE_POSSESSION 收窄，**不要**再用
#      ALLOW_FIRST_BIND=false —— 后者会让所有新装用户从此用不了云端同步，
#      而不只是挡住抢注者；REQUIRE_POSSESSION 只要求"已有云端存档却首次注册"的设备
#      出示 saveId+createdAt 证明持有该存档，新设备完全不受影响。
#      翻开它之前必须先把前端发到能响应 403 PROOF_REQUIRED 的版本，顺序反了会把
#      合法属主挡在门外（老客户端拿不出证明，也不带证明重试）。
# 线上以 NUXT_ 前缀在运行时覆盖（见 deploy/docker-compose.deploy.yml）
DEVICE_AUTH_ENFORCED=false
DEVICE_AUTH_ALLOW_FIRST_BIND=true
DEVICE_AUTH_REQUIRE_POSSESSION=false
