# LLM Provider 配置（硅基流动 SiliconFlow）
# 注册获取 API Key: https://cloud.siliconflow.cn
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.siliconflow.cn/v1

# 默认 LLM 模型（Qwen3-8B 支持工具调用 + 可切换思考）
LLM_MODEL=Qwen/Qwen3-8B

# 数据库连接（PostgreSQL 18，端口 5534 避开 my-chat 的 5434）
DATABASE_URL=postgresql://sw_game:YOUR_DB_PASSWORD@localhost:5534/sw_game
