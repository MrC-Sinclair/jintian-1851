{
  "name": "jintian-1851-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxi dev",
    "build": "nuxi build",
    "generate": "nuxi generate",
    "preview": "nuxi preview",
    "postinstall": "nuxi prepare",
    "typecheck": "nuxt typecheck",
    "lint:js": "eslint . --max-warnings 0",
    "lint:js:fix": "eslint . --fix --max-warnings 0",
    "lint:css": "stylelint \"**/*.{css,vue,scss}\" --allow-empty-input",
    "lint:css:fix": "stylelint \"**/*.{css,vue,scss}\" --fix --allow-empty-input",
    "lint": "npm-run-all -p lint:js lint:css",
    "lint:fix": "npm-run-all -p lint:js:fix lint:css:fix",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:api": "vitest run tests/api",
    "test:watch": "vitest",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate",
    "check-models": "tsx --env-file=.env server/scripts/check-models.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^2.0.106",
    "ai": "^5.0.196",
    "drizzle-orm": "^0.36.0",
    "nuxt": "^3.15.0",
    "postgres": "^3.4.5",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^25.6.0",
    "@typescript-eslint/parser": "^8.58.2",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/test-utils": "^2.4.6",
    "drizzle-kit": "^0.29.0",
    "eslint": "^9.17.0",
    "eslint-plugin-vue": "^10.8.0",
    "jsdom": "^25.0.0",
    "npm-run-all2": "^9.0.2",
    "prettier": "^3.4.0",
    "stylelint": "^17.14.0",
    "stylelint-config-recess-order": "^7.7.0",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard": "^40.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.2.7"
  },
  "packageManager": "pnpm@11.14.0+sha512.66c1ac4c7d4762d6d7dde44c7f3e5a73591ed0a0806e751d4ed32d4f004f25b2285a906b1fd8a9e3e621df3b4e2858bf88e50e0cf626bedbe977fe434a5caf85"
